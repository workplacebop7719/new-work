{
  "name": "northstar",
  "private": true,
  "version": "0.1.0",
  "description": "Project Northstar \u2014 AODA Readiness Platform",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint && pnpm run guards",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @northstar/web run test:e2e",
    "test:a11y": "pnpm --filter @northstar/web run test:a11y",
    "test:authz": "pnpm --filter @northstar/auth run test:authz",
    "db:migrate": "pnpm --filter @northstar/db run migrate",
    "db:seed": "pnpm --filter @northstar/db run seed",
    "db:reset-safe": "pnpm --filter @northstar/db run reset-safe",
    "db:retention": "pnpm --filter @northstar/db run retention",
    "guards": "node scripts/guards/run-all.mjs",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.8.1",
    "turbo": "2.10.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
