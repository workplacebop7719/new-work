# Copy to .env.local for local development. Never commit a real .env file.

# Local Postgres (ADR-0003). `db:reset-safe` refuses any non-local host.
DATABASE_URL=postgres://postgres@localhost:5432/northstar_dev
APP_ENV=development

# The application role. Must be NOBYPASSRLS: a superuser silently defeats
# every row-level security policy in the schema.
DB_APP_ROLE=northstar_app

# Salt for rate-limit keys. Any long random string; rotate freely — rotating only
# resets counters. Never store raw client IP addresses (SEC-007).
RATE_LIMIT_SECRET=dev-only-change-me
