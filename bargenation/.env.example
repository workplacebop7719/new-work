# Leave DATABASE_URL unset to run on the in-memory fictional dataset.
# Both paths feed the same scoring engine and produce the same Value Index.
#
# Must name a NON-SUPERUSER role: superusers and roles with BYPASSRLS ignore
# row level security, which would defeat every policy in migration 0003.
DATABASE_URL=postgresql://bargenation_app:CHANGE_ME@127.0.0.1:5433/bargenation_dev

# Used only by the tests. Never point these at a database you value.
#
# SET ALL FOUR OR THE SUITE LIES TO YOU. Every database test — every RLS
# policy, every cross-tenant refusal, every column grant — skips itself when
# its URL is unset, and a skipped negative test reports green in exactly the
# same colour as a passing one. That is 189 of them. The other two live
# further down, next to the roles they belong to.
#
# `npm test` reads this file (test/load-env.ts), so copying it to .env.local
# is enough; nothing needs exporting.
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5433/bargenation_dev
TEST_APP_DATABASE_URL=postgresql://bargenation_app:CHANGE_ME@127.0.0.1:5433/bargenation_dev

# The origin recovery and confirmation links are built against. Only used when
# no provider is configured — a real provider builds its own links.
NEXT_PUBLIC_SITE_URL=http://localhost:3210

# Keys everything the application must recognise again but must not store: bot
# challenge signatures, and the rate-limit tokens derived from an email address
# or a connection. Without it a per-process key is generated — everything still
# works, it just stops being consistent across a restart or a second instance.
# At least 16 characters. CHALLENGE_SECRET is still read, under its old name.
APP_SECRET=

# Authentication. Without these, sign-in controls render disabled with a reason,
# and in production the auth port refuses every operation rather than falling
# back to the in-memory development adapter.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Deliberately NOT used anywhere: the service-role key bypasses row level
# security and must never be available to request-handling code.

# The Deal Signal sweep. Must name the bargenation_jobs role: its grants are
# enumerated in migration 0007 and deliberately exclude saved items,
# households, preferences and schema commerce.
SIGNALS_DATABASE_URL=postgresql://bargenation_jobs:CHANGE_ME@127.0.0.1:5433/bargenation_dev
TEST_JOBS_DATABASE_URL=postgresql://bargenation_jobs:CHANGE_ME@127.0.0.1:5433/bargenation_dev

# The operations surface. Must name the bargenation_admin role: its grants are
# enumerated in migration 0010 and deliberately exclude households, watchlists,
# saved items, preferences, subscribers and schema commerce.
ADMIN_DATABASE_URL=postgresql://bargenation_admin:CHANGE_ME@127.0.0.1:5433/bargenation_dev
TEST_ADMIN_DATABASE_URL=postgresql://bargenation_admin:CHANGE_ME@127.0.0.1:5433/bargenation_dev

# Legal details. NEVER invent these — they are facts about a company, not copy.
# While unset, the legal pages list them as outstanding rather than filling
# them with something plausible. See src/content/legal.ts.
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_GOVERNING_JURISDICTION=
