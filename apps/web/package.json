{
  "name": "@northstar/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint app lib",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "clean": "rm -rf .next dist *.tsbuildinfo"
  },
  "dependencies": {
    "@northstar/auth": "workspace:*",
    "@northstar/domain": "workspace:*",
    "@northstar/integrations": "workspace:*",
    "@northstar/observability": "workspace:*",
    "@northstar/ui": "workspace:*",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
